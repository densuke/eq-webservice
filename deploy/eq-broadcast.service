# eq-server broadcast: e2 から YouTube へ直接配信する (native・無音)。本番の eq-server を守るため CPU とメモリを縛る
# ~/.config/systemd/user/eq-broadcast.service に置く (docs は README の「e2 から直接配信する」)
[Unit]
Description=eq-webservice ライブ配信 (eq-server broadcast -> YouTube)
After=eq-server.service network-online.target
Wants=network-online.target
# eq-server を再起動・停止すると一緒に再起動・停止する (同じバイナリなので、差し替えで版をそろえる)
PartOf=eq-server.service

[Service]
Type=simple
WorkingDirectory=%h/work/eq-e2cast
ExecStart=%h/work/eq-e2cast/eq-server broadcast cast.toml
# ストリームキー (YOUTUBE_LIVE_API_KEY=...、権限 600)
EnvironmentFile=%h/.config/youtube-live-eq-webservice
Environment=RUST_LOG=info
Restart=always
RestartSec=10
# 配信を最低優先度にしない (Nice は付けない)。重い処理 (再現動画) の側を下げる (Issue #204)
# 配信専用のマシンなら 1 vCPU まで使わせる。低いと 1 秒ごとの描き直し・エンコードの瞬間に cgroup の周期(100ms)で
# 止められ、描画の遅れ・送り出しの詰まりになる (#206: 50% で時間の約 3 割止められていた)
CPUQuota=100%
MemoryMax=320M
# 配信に MemoryHigh は最初は設定しない: 平常の anon が 104〜142MB で、MemoryHigh を下回ると swap がほぼ無いため
# 強い throttling で配信が壊れる。上限に当たるのは主にページキャッシュ (Issue #196) で、ring の破棄で減らす。
# 必要になったら MemoryMax の 9 割 (MemoryMax=320M なら MemoryHigh=288M) にする
MemorySwapMax=0

[Install]
WantedBy=default.target
