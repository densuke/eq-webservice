# 	@stream path /stream/bgm.mp3 /stream/status-json.xsl
# 	handle @stream {
# 		uri strip_prefix /stream
# 		reverse_proxy 127.0.0.1:8010 {
# 			flush_interval -1
# 		}
# 	}
# 	handle {
# 		encode zstd gzip
# 		reverse_proxy 127.0.0.1:8080
# 	}
# }
